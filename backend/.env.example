APP_NAME=AI Meeting Workspace
APP_VERSION=0.1.0

# Database Configuration (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://meeting_user:meeting_password@localhost:5432/meeting_workspace

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Celery & Background Tasks
REDIS_URL=redis://localhost:6379/0

# LLM & AI Provider Configuration
# Set your Gemini API key (recommended) or OpenAI API key
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto  # "auto", "gemini", or "openai"

# Hugging Face Token (Optional, for downloading Pyannote models)
# If models are already cached locally, this can remain blank.
HF_TOKEN=
